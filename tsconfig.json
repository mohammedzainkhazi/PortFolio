{
  "compilerOptions": {
   "module": "esnext",
    "target": "esnext",
    "lib": ["dom", "dom.iterable", "es2015"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom","node"],
    "moduleResolution": "node",
    "allowSyntheticDefaultImports":true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
}